# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: invite-only mode. Without it every new sign-in gets its own
# workspace. With it, people only get in by accepting an invitation; everyone
# else lands on /no-access. WORKSPACE_CREATOR_EMAILS may still start their own
# workspace (someone has to create the first one and connect Instagram).
# INVITE_ONLY=true
# WORKSPACE_CREATOR_EMAILS=you@asu.edu

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Optional: ASU CAS single sign-on. Adds a "Sign in with ASU" button next to
# magic links. Register CAS_SERVICE_URL (default
# NEXTAUTH_URL/api/auth/cas/callback) with ASU before turning it on.
# ALLOWED_EMAILS above applies to SSO sign-ins too.
# CAS_ENABLED=true
# CAS_BASE_URL=https://weblogin.asu.edu/cas
# CAS_LOGIN_URL=            # default CAS_BASE_URL/login
# CAS_VALIDATE_URL=         # default CAS_BASE_URL/serviceValidate
# CAS_SERVICE_URL=          # default NEXTAUTH_URL/api/auth/cas/callback
# CAS_EMAIL_DOMAIN=asu.edu  # fallback email is <asurite>@this when CAS omits mail
# CAS_ATTR_ASURITE=uid,asuEduID,asuEduPersonID,eduPersonPrincipalName
# CAS_ATTR_EMAIL=mail,email
# CAS_ATTR_NAME=displayName,cn

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token
